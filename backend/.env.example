# Sao chép thành backend/.env. Giá trị dưới đây chỉ dùng cho docker compose dev.
ENV=dev
DATABASE_URL=postgresql+asyncpg://evfta:evfta@localhost:5432/evfta
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=eu-central-1
S3_BUCKET=evfta-private
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devkey
# Trợ lý AI thử miễn phí bằng Ollama cục bộ (cài Ollama rồi: ollama pull bge-m3 && ollama pull qwen2.5:7b).
# Mặc định fake. Đổi embedding thì nạp lại corpus và chạy lại eval 50 câu (AGENTS.md §6.11).
# CHAT_BACKEND=ollama
# EMBEDDING_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=bge-m3
