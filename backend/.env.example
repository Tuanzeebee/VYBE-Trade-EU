# Sao chép thành backend/.env. Giá trị dưới đây chỉ dùng cho docker compose dev.
ENV=dev
DATABASE_URL=postgresql+asyncpg://evfta:evfta@localhost:5432/evfta
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=eu-central-1
S3_BUCKET=evfta-private
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devkey
# Trợ lý AI thử miễn phí bằng Ollama cục bộ (cài Ollama rồi: ollama pull bge-m3 && ollama pull qwen2.5:7b).
# Mặc định fake. Đổi embedding thì nạp lại corpus và chạy lại eval 50 câu (AGENTS.md §6.11).
# CHAT_BACKEND=ollama
# EMBEDDING_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=bge-m3
# Dữ liệu tuân thủ minh hoạ (AGENTS.md §6.2 ngoại lệ DEMO) — chỉ bật ở dev/staging, cấm ở prod.
# DEMO_COMPLIANCE_DATA=true
# Điểm tín nhiệm công khai trên hồ sơ (ADR-0004) — production giữ tắt tới khi pháp lý duyệt.
# TRUST_SCORE_PUBLIC=true
# Tài khoản nhận chuyển khoản in trên đơn (U19, ADR-0005). Mặc định là minh hoạ; production bắt buộc đặt.
# BANK_TRANSFER_BANK_NAME=Vietcombank - CN Hà Nội
# BANK_TRANSFER_ACCOUNT_NAME=CONG TY ...
# BANK_TRANSFER_ACCOUNT_NUMBER=...
# BANK_TRANSFER_IBAN=
# BANK_TRANSFER_SWIFT=BFTVVNVX
