                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description Vi"
          },
          "description_en": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description En"
          },
          "company_size": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "1_10",
                  "11_50",
                  "51_200",
                  "201_500",
                  "gt_500"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Size"
          },
          "procurement_estimate": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "lt_100k",
                  "100k_500k",
                  "500k_2m",
                  "2m_10m",
                  "gt_10m"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Procurement Estimate"
          },
          "vat_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Vat Number"
          },
          "legal_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Legal Name"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Country",
            "default": "VN"
          },
          "export_markets": {
            "items": {
              "type": "string",
              "pattern": "^(EU|ASEAN|[A-Z]{2})$"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Export Markets"
          },
          "languages_spoken": {
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}$"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Languages Spoken"
          },
          "sourcing_categories": {
            "items": {
              "type": "string",
              "enum": [
                "agriculture",
                "seafood",
                "food_beverage",
                "textiles",
                "handicrafts",
                "spices"
              ]
            },
            "type": "array",
            "maxItems": 20,
            "title": "Sourcing Categories"
          }
        },
        "type": "object",
        "required": [
          "legal_name"
        ],
